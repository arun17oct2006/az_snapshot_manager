{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "appName",
        "type": "Microsoft.Common.TextBox",
        "label": "Application name",
        "toolTip": "Used to derive the names of the App Service, Storage account and Managed Identity.",
        "defaultValue": "snapshotmgr",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9-]{2,20}$",
          "validationMessage": "3-21 lowercase letters, numbers or hyphens, starting with a letter."
        }
      },
      {
        "name": "skuName",
        "type": "Microsoft.Common.DropDown",
        "label": "App Service Plan tier",
        "defaultValue": "B1 (Basic)",
        "constraints": {
          "allowedValues": [
            { "label": "B1 (Basic)", "value": "B1" },
            { "label": "S1 (Standard)", "value": "S1" },
            { "label": "P0v3 (Premium)", "value": "P0v3" },
            { "label": "P1v3 (Premium)", "value": "P1v3" }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "identityStep",
        "label": "Authentication",
        "elements": [
          {
            "name": "aadTenantId",
            "type": "Microsoft.Common.TextBox",
            "label": "Microsoft Entra tenant ID",
            "toolTip": "The tenant that will authenticate Cloud Administrators / DevOps / FinOps Analysts on the dashboard.",
            "constraints": { "required": true, "regex": "^[0-9a-fA-F-]{36}$", "validationMessage": "Enter a valid GUID." }
          },
          {
            "name": "aadClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "App registration client ID",
            "toolTip": "Client ID of the Entra ID app registration created for this Marketplace offer.",
            "constraints": { "required": true, "regex": "^[0-9a-fA-F-]{36}$", "validationMessage": "Enter a valid GUID." }
          }
        ]
      },
      {
        "name": "billingStep",
        "label": "Marketplace billing",
        "elements": [
          {
            "name": "publisherOfferId",
            "type": "Microsoft.Common.TextBox",
            "label": "Marketplace offer ID",
            "defaultValue": "azure-snapshot-manager",
            "toolTip": "Used to tag metered billing usage events sent to Partner Center (WBS 1.1.3).",
            "constraints": { "required": true }
          }
        ]
      }
    ]
  },
  "outputs": {
    "appName": "[basics('appName')]",
    "skuName": "[basics('skuName')]",
    "aadTenantId": "[steps('identityStep').aadTenantId]",
    "aadClientId": "[steps('identityStep').aadClientId]",
    "publisherOfferId": "[steps('billingStep').publisherOfferId]",
    "location": "[location()]"
  }
}
